import { Code } from 'astro-expressive-code/components'

/**
 * A code block on the marketing page, rendered by the same Expressive Code that renders the
 * documentation. A shell command gets the three dots of a terminal, anything else a tab with
 * its name, and the copy button waits in the corner until the block is hovered.
 *
 * The component comes from `astro-expressive-code` rather than from Starlight, which
 * re-exports it. Starlight's barrel pulls in eleven other components and their stylesheet
 * with them, and that reset outranks Tailwind's layered utilities and flattens the page.
 */
interface Props {
  code: string
  lang: 'bash' | 'js' | 'json'
  /** The name in the tab. Shell shows the terminal dots instead and ignores it. */
  label?: string
  class?: string
}

const LABELS: Record<Props['lang'], string> = {
  bash: 'Shell',
  js: 'JavaScript',
  json: 'JSON',
}

const { code, lang, label, class: className = '' } = Astro.props
const title = lang === 'bash' ? undefined : (label ?? LABELS[lang])
---

<div class:list={['code-block', className]}>
  <Code code={code} lang={lang} title={title} />
</div>

<script>
  import { track } from '../lib/analytics.ts'

  // Expressive Code renders its own copy button, so the event is wired to that rather than
  // to one of ours.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null
    if (target?.closest('.code-block .copy button')) track('Copied a code snippet')
  })
</script>
