import { API_ORIGIN, OPENAPI_URL } from '../config.ts'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>API reference — Rollful</title>
    <meta
      name="description"
      content="Interactive reference for the Rollful dice-rolling API. Try every endpoint from the browser."
    />
    <!-- Astro builds directory-style, so the served URL carries the trailing slash. -->
    <link rel="canonical" href="https://rollful.dev/reference/" />
  </head>
  <body>
    <div id="reference" data-spec={OPENAPI_URL} data-origin={API_ORIGIN}></div>

    <script>
      import { createApiReference } from '@scalar/api-reference'
      import '@scalar/api-reference/style.css'

      const mount = document.getElementById('reference')!

      createApiReference(mount, {
        url: mount.dataset.spec,
        // Overrides the server the document names, so "try it" reaches whichever API this
        // build points at rather than always production.
        servers: [{ url: mount.dataset.origin }],
        // The API is public and unauthenticated, so curl is the example worth leading with.
        defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
        // Defaults to 'localhost', so Scalar's authoring toolbar would appear here but not
        // in production. Pinned off so what we review locally is what ships.
        showDeveloperTools: 'never',
        mcp: { disabled: true },
        metaData: {
          title: 'API reference — Rollful',
          description: 'Interactive reference for the Rollful dice-rolling API.',
        },
        // "Ask AI" uploads the OpenAPI document to Scalar and puts their Terms and Privacy
        // Policy on this page. Hidden by href, which survives their class names changing.
        // "Powered by Scalar" is deliberately left alone as credit for the tool.
        customCss: `
          .disclaimerText { display: none; }
          a[href*="scalar.com/legal"] { display: none; }
        `,
      })

      hideAskAi()

      /**
       * The Ask AI button carries only utility classes and a Vue scope attribute, so there
       * is nothing stable to write CSS against. Matching its label instead fails safe: if
       * Scalar renames it, the button reappears rather than something else disappearing.
       */
      function hideAskAi() {
        const deadline = Date.now() + 5000
        const timer = setInterval(() => {
          const button = [...document.querySelectorAll('button')].find(
            (b) => b.textContent?.trim() === 'Ask AI',
          )
          if (button) {
            button.style.display = 'none'
            clearInterval(timer)
          } else if (Date.now() > deadline) {
            clearInterval(timer)
          }
        }, 100)
      }
    </script>
  </body>
</html>
