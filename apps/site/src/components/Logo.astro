/**
 * A d20 seen face on. The silhouette of an icosahedron from this angle is a hexagon, and
 * all eighteen edges of the ten visible faces are drawn, which is what makes it read as a
 * die rather than as a geometric mark.
 *
 * Drawn in `currentColor` so it takes the colour of whatever it sits in. `detail={false}`
 * keeps only the outline, the front face and the three upper edges, for sizes where the
 * full wireframe fills in.
 */
interface Props {
  class?: string
  detail?: boolean
  strokeWidth?: number
}

const { class: className = 'h-6 w-6', detail = true, strokeWidth = 1.5 } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linejoin="round"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d="M16 2 28.12 9v14L16 30 3.88 23V9z"></path>
  <path d="M16 7.5 23.7 20.3H8.3z"></path>
  <path d="M16 2v5.5M3.88 9 16 7.5M28.12 9 16 7.5"></path>
  {
    detail && (
      <path d="M3.88 9 8.3 20.3M28.12 9 23.7 20.3M3.88 23 8.3 20.3M28.12 23 23.7 20.3M16 30 8.3 20.3M16 30 23.7 20.3" />
    )
  }
</svg>
