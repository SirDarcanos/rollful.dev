import { Code } from 'astro:components'
import { SHIKI_THEMES } from '../shiki-theme.ts'

interface Props {
  code: string
  lang: 'bash' | 'js' | 'json'
  /** Overrides the label taken from `lang`. */
  label?: string
  class?: string
}

const LABELS: Record<Props['lang'], string> = {
  bash: 'Shell',
  js: 'JavaScript',
  json: 'JSON',
}

const { code, lang, label, class: className = '' } = Astro.props
const heading = label ?? LABELS[lang]
---

<div
  class:list={[
    'code-block overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 dark:border-white/10 dark:bg-ink-soft',
    className,
  ]}
  data-code={code}
>
  <div
    class="flex items-center justify-between gap-4 border-b border-zinc-200 px-4 py-2 dark:border-white/10"
  >
    <span class="text-[11px] font-semibold tracking-widest text-zinc-500 uppercase">{heading}</span>
    <button
      type="button"
      class="copy -mr-1 shrink-0 rounded-md p-1.5 text-zinc-500 hover:text-ink dark:hover:text-aqua"
      aria-label={`Copy the ${heading} snippet`}
    >
      <svg
        class="copy-idle h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="8" y="8" width="14" height="14" rx="2"></rect>
        <path d="M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"></path>
      </svg>
      <svg
        class="copy-done hidden h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m20 6-11 11-5-5"></path>
      </svg>
    </button>
  </div>
  <div class="overflow-x-auto p-4 text-xs">
    <Code code={code} lang={lang} themes={SHIKI_THEMES} defaultColor={false} />
  </div>
</div>

<script>
  import { wireCopy } from '../lib/copy.ts'

  for (const button of document.querySelectorAll<HTMLButtonElement>('.code-block .copy')) {
    const block = button.closest('.code-block') as HTMLElement
    wireCopy(button, () => block.dataset.code!)
  }
</script>
