import Logo from './Logo.astro'

const NPM = 'https://www.npmjs.com/package/opendice'
---

<!-- Full width rather than the site's content column: this sits above Scalar, which runs
     edge to edge, and a centred bar would float out of line with everything under it. -->
<header class="shrink-0 border-b border-zinc-200 dark:border-white/10">
  <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 text-lg font-semibold tracking-tight">
      <Logo class="h-6 w-6 text-teal dark:text-aqua" />
      Rollful
    </a>
    <nav class="flex flex-wrap items-center gap-6 text-sm text-zinc-600 dark:text-zinc-400">
      <a href="/reference/" class="hover:text-ink dark:hover:text-white">API reference</a>
      <a href={NPM} class="hover:text-ink dark:hover:text-white">OpenDice on npm</a>
      <a
        href="https://github.com/SirDarcanos/rollful.dev"
        class="hover:text-ink dark:hover:text-white">GitHub</a
      >
    </nav>
  </div>
</header>
